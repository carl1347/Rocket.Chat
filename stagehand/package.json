{
	"name": "rocketchat-stagehand-e2e",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "AI-driven E2E tests with Stagehand and a local Ollama model, for 5 Rocket.Chat features",
	"engines": {
		"node": ">=24.15.0"
	},
	"devDependencies": {
		"@browserbasehq/stagehand": "4.4.0",
		"@types/node": "22.10.2",
		"typescript": "5.6.3",
		"zod": "4.6.6"
	},
	"scripts": {
		"ollama:check": "node scripts/check-ollama.mjs",
		"test": "node scripts/run.mjs --feature all",
		"test:threads": "node scripts/run.mjs --feature threads",
		"test:rbac": "node scripts/run.mjs --feature rbac",
		"test:dm": "node scripts/run.mjs --feature dm",
		"test:retention": "node scripts/run.mjs --feature retention",
		"test:webhooks": "node scripts/run.mjs --feature webhooks",
		"test:unit": "node --test unit/*.test.ts",
		"typecheck": "tsc --noEmit"
	}
}
